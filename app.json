{
  "expo": {
    "name": "ShadiPlan",
    "slug": "shadiplan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B2C1F"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "15.4",
      "bundleIdentifier": "in.redevolve.shadiplan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.redevolve.shadiplan",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F0"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "@lottiefiles/dotlottie-react-native/plugin",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow ShadiPlan to access your contacts to add guests quickly."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B2C1F",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShadiPlan to attach estimate photos to vendor shortlist."
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "updates": {
      "url": "https://u.expo.dev/f790462d-c3a1-4a1b-8c9e-7cbd80519f15"
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "f790462d-c3a1-4a1b-8c9e-7cbd80519f15"
      }
    }
  }
}
