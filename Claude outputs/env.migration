# ShadiPlan Migration Environment Variables
# Add these to your .env file during migration

# ============================================
# Phase 1-3: Dual-Write Phase (USE_NEON=false)
# ============================================

# Original Supabase configuration (keep as-is)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# New Neon configuration (add during Phase 1)
# Get from: https://console.neon.tech → Project → Connection string
EXPO_PUBLIC_NEON_DATABASE_URL=postgresql://[username]:[password]@ep-xxxxx.neon.tech/neondb

# Feature flag to enable Neon (start with false)
# Phase 1-3: false (Supabase primary, Neon shadow writes)
# Phase 4+: true (Neon primary, Supabase shadow writes)
# Final: true (Neon only)
EXPO_PUBLIC_USE_NEON=false

# Optional: Enable migration debug logging
EXPO_PUBLIC_MIGRATION_DEBUG=true

# ============================================
# Don't change these during migration
# ============================================

# Deployed web app origin (used for photo album guest QR / upload links)
EXPO_PUBLIC_WEB_APP_URL=https://shadiplan.redevolve.in

# ============================================
# Cutover Timeline
# ============================================
#
# Week 1-2:   EXPO_PUBLIC_USE_NEON=false (shadow writes only)
#             Monitor logs, verify both systems in sync
#
# Week 3-5:   EXPO_PUBLIC_USE_NEON=false → true (gradual shift)
#             Deploy with feature flags to gradually move traffic
#
# Week 6+:    EXPO_PUBLIC_USE_NEON=true (Neon primary)
#             Keep Supabase shadow writes for 2 more weeks as backup
#
# Week 8+:    Remove Supabase shadow write code
#             Archive Neon data
#             Delete Supabase project (optional, but saves $$)
