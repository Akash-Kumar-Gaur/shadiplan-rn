# Copy to your shell env (do not commit real values).
# Usage example:
#   export KEYSTORE_PATH=/absolute/path/to/shadiplan-upload.keystore
#   export KEYSTORE_PASSWORD=your-store-password
#   export KEY_ALIAS=shadiplan
#   export KEY_PASSWORD=your-key-password
#   cd android && ./gradlew bundleRelease
#
# Optional local fallback (also gitignored): android/keystore.properties
#   storeFile=shadiplan-upload.keystore
#   storePassword=...
#   keyAlias=shadiplan
#   keyPassword=...

KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
